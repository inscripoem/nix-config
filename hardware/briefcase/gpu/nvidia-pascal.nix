{ config, lib, ... }:

# GPU profile: NVIDIA Quadro P620 (Pascal, GP107, 2 GB GDDR5).
#
# Everything in this file exists because of this specific card + driver
# combination. To swap GPUs, do NOT edit this file — add a sibling
# profile (e.g. nvidia-ada.nix, amd-rdna3.nix) and change the import in
# ../default.nix. Keeping old profiles around makes swap-back a one-line
# diff.
#
# === Driver branch (NEW concern for Pascal) ===========================
#
# Pascal was dropped from NVIDIA's mainline driver in the 590 series.
# 580.xx is therefore the *last* branch that supports GP107, and NVIDIA
# / packagers explicitly label it the "legacy 580" branch going forward
# (see e.g. the rpmfusion xorg-x11-drv-nvidia-580xx package metadata).
#
# Today (June 2026) nixpkgs is still on the 580 series for `production`
# / `stable` — Turing also runs this exact driver — so for P620 we want
# to ride `production` for now. The risk we are guarding against is the
# day nixpkgs bumps `production` to 590+: that would silently hand us a
# driver that does not bind GP107.
#
# We therefore:
#   1. Pin the driver attribute explicitly to `production` (even though
#      that is the module default), so the intent is greppable.
#   2. Assert the version string still starts with "580.". When upstream
#      bumps to 590, eval breaks loudly, and the fix is to switch this
#      file to `nvidiaPackages.legacy_580` (which nixpkgs is expected to
#      ship at that point, following the legacy_470 / legacy_535 pattern).
#
# === Knob rationale (unchanged from Turing profile) ===================
#
# §1 open vs proprietary, §2 powerManagement, §3
# KWIN_DRM_DISABLE_EXPLICIT_SYNC: all documented in docs/nvidia.md.
# Every conclusion there applies unchanged to GP107 on the same 580.x
# driver. Pascal is also absent from the open-module support list, so
# `open = false` is mandatory, not just recommended.

{
  hardware.graphics.enable = true;

  services.xserver.videoDrivers = [ "nvidia" ];

  # Explicit driver pin. Mirrors the current `production` default, but
  # writing it down (a) documents intent and (b) anchors the assertion
  # below to a single source of truth.
  hardware.nvidia.package = config.boot.kernelPackages.nvidiaPackages.production;

  # See top-of-file rationale. When this fires, the fix is to flip the
  # line above to `nvidiaPackages.legacy_580` (or whatever name nixpkgs
  # ends up shipping for the Pascal-supporting branch).
  assertions = [
    {
      assertion = lib.hasPrefix "580." config.hardware.nvidia.package.version;
      message = ''
        briefcase GPU profile (P620 / Pascal / GP107) requires the NVIDIA
        580.xx driver branch — Pascal is not supported by the mainline
        590+ driver. Current package version is
        "${config.hardware.nvidia.package.version}".

        Likely cause: nixpkgs bumped `nvidiaPackages.production` past
        580.xx. Switch
            hardware.nvidia.package = ... .nvidiaPackages.production;
        to
            hardware.nvidia.package = ... .nvidiaPackages.legacy_580;
        in hardware/briefcase/gpu/nvidia-pascal.nix (or verify any newer
        Pascal-supporting branch nixpkgs may now expose).
      '';
    }
  ];

  # Pascal is NOT on the open kernel module support list (open requires
  # Turing data-center, GTX 16xx, or Ampere+). See docs/nvidia.md §1.
  hardware.nvidia.open = false;

  # KMS for Wayland (KWin DRM backend).
  hardware.nvidia.modesetting.enable = true;

  # NVreg_PreserveVideoMemoryAllocations=1 + nvidia-{suspend,resume,
  # hibernate}.service. Without this, resume corrupts the first frame
  # and GL/Vulkan apps lose their context. See docs/nvidia.md §2.
  # Bonus on P620: only 2 GB VRAM means the /var/tmp dump is tiny.
  hardware.nvidia.powerManagement.enable = true;

  # KWin 6.5 + NVIDIA 580 explicit sync (linux-drm-syncobj-v1) workaround.
  # See docs/nvidia.md §3. The bug is in 580.x's DRM path, not in any
  # specific GPU architecture, so it applies to Pascal too.
  environment.sessionVariables.KWIN_DRM_DISABLE_EXPLICIT_SYNC = "1";
}

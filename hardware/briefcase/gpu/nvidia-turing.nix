# GPU profile: NVIDIA GeForce RTX 2060 SUPER (Turing, TU106).
#
# Everything in this file exists because of this specific card + driver
# combination. To swap GPUs, do NOT edit this file — add a sibling
# profile (e.g. nvidia-ada.nix, amd-rdna3.nix) and change the import in
# ../default.nix. Keeping old profiles around makes swap-back a one-line
# diff.
#
# The "why" for each knob lives in docs/nvidia.md (§1 open vs proprietary,
# §2 powerManagement, §4 KWin explicit-sync workaround). That file is a
# Turing/580.x bug log, not a config index, so don't try to read this
# file out of it — read it here.

{
  hardware.graphics.enable = true;

  # Proprietary nvidia.ko — TU106 is not on the open-module support list.
  # See docs/nvidia.md §1 before flipping `open` to true.
  services.xserver.videoDrivers = [ "nvidia" ];
  hardware.nvidia.open = false;

  # KMS for Wayland (KWin DRM backend).
  hardware.nvidia.modesetting.enable = true;

  # NVreg_PreserveVideoMemoryAllocations=1 + nvidia-{suspend,resume,
  # hibernate}.service. Without this, resume corrupts the first frame
  # and GL/Vulkan apps lose their context. See docs/nvidia.md §2.
  hardware.nvidia.powerManagement.enable = true;

  # KWin 6.5 + NVIDIA 580 explicit sync (linux-drm-syncobj-v1) workaround.
  # Symptoms: login freezes on SDDM/KSplash until a VT switch, or session
  # silently dies back to SDDM mid-startup. See docs/nvidia.md §4 for
  # the full diagnosis and the conditions under which this can be removed.
  environment.sessionVariables.KWIN_DRM_DISABLE_EXPLICIT_SYNC = "1";
}

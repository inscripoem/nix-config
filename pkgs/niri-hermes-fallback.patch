+        // In display-only mode the allocator hands out linear buffers, but
+        // GPU renderers usually advertise only tiled dmabuf render formats
+        // (radeonsi does not list Linear at all). Synthesize the
+        // (code, Linear) entries the swapchain needs instead of relying on
+        // them being advertised.
+        let mut render_formats = render_formats;
+        if device.render_node.is_none() {
+            // 8-bit codes only: 10-bit linear dmabufs are commonly not
+            // importable by hardware VAAPI encoders (and a virtual display
+            // gains nothing from them). Argb8888 first — its opaque pair
+            // AR24 is what hardware pipelines import most readily.
+            let linear_extra = [
+                Fourcc::Argb8888,
+                Fourcc::Xrgb8888,
+                Fourcc::Abgr8888,
+            ]
+            .into_iter()
+            .map(|code| Format {
+                code,
+                modifier: Modifier::Linear,
+            });
+            render_formats = render_formats.into_iter().chain(linear_extra).collect();
+            debug!(
+                "display-only probe on {}: render_formats={render_formats:?}",
+                connector_name
+            );
+        }

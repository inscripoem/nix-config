+    /// Degrade a secondary device with a render node to display-only: drop
+    /// its render node and switch to the primary device's allocator, so
+    /// scanout buffers are allocated on the primary GPU and imported into
+    /// the plane directly.
+    ///
+    /// This is for virtual display drivers that expose DRIVER_RENDER and a
+    /// render node for their own UAPI (e.g. Hermes-KMS), but have no Mesa
+    /// DRI driver: the compositor cannot initialize a GL renderer on them,
+    /// and every plane format negotiation fails. Such devices can still
+    /// scan out primary-allocated buffers, exactly like devices without a
+    /// render node.
+    fn degrade_device_to_display_only(&mut self, node: &DrmNode) -> anyhow::Result<()> {
+        if *node == self.primary_node {
+            bail!("refusing to degrade the primary device");
+        }
+        let primary_allocator = self
+            .devices
+            .get(&self.primary_node)
+            .context("missing primary device")?
+            .allocator
+            .clone();
+        let device = self.devices.get_mut(node).context("missing device")?;
+        let render_node = device
+            .render_node
+            .context("device has no render node, already display-only")?;
+        debug!("degrading device {node} to display-only (dropping render node {render_node})");
+        device.render_node = None;
+        device.allocator = primary_allocator;
+        Ok(())
+    }
+
     fn connector_connected(

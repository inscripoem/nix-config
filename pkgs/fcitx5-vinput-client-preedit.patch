diff --git a/src/addon/dbus/vinput_dbus.cpp b/src/addon/dbus/vinput_dbus.cpp
index 7276dd8..afdce57 100644
--- a/src/addon/dbus/vinput_dbus.cpp
+++ b/src/addon/dbus/vinput_dbus.cpp
@@ -913,7 +913,21 @@ void VinputEngine::onRecognitionResult(fcitx::dbus::Message& msg) {
     }
   }
 
+  // Emit the final text as client-side preedit before committing so the
+  // commit rides an active IME composition. Clients that gate IME handling on
+  // composition state (e.g. Chromium terminals with a composition tracker)
+  // drop commit_string events that arrive without any preceding preedit.
+  fcitx::Text clientPreedit;
+  clientPreedit.append(payload.commitText);
+  ic->inputPanel().setClientPreedit(clientPreedit);
+  ic->updatePreedit();
+
   ic->commitString(payload.commitText);
+
+  // Clear the client-side preedit so the stale final text cannot linger in
+  // the input panel until the next dictation overwrites it.
+  ic->inputPanel().setClientPreedit(fcitx::Text());
+  ic->updatePreedit();
 }
 

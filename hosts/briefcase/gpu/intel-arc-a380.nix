{ pkgs, ... }:

# GPU profile: Intel Arc A380 (DG2/Alchemist, PCI ID 0x56a5).
#
# To swap GPUs, do NOT edit this file — add a sibling profile and change the
# import in ../default.nix. Keeping old profiles around makes swap-back a
# one-line diff.

{
  # Mesa userspace + VA-API / VPL / OpenCL libs need /run/opengl-driver.
  hardware.graphics.enable = true;

  # Modern Intel (Gen12+/Arc) uses the modesetting DDX.
  services.xserver.videoDrivers = [ "modesetting" ];

  # Arc A380 is DG2; load i915 early and force-bind it.
  boot.initrd.kernelModules = [ "i915" ];
  boot.kernelParams = [
    # DG2 default: GuC submission + HuC. GuC submission also enables SLPC
    # and context-level hang recovery; the execlists fallback only supports
    # a full-chip reset, which failed and wedged the device during
    # concurrent encode + compute on 2026-11-01.
    "i915.enable_guc=3"
    # Keep display power wells out of DC3/5/6 so DMC power-well handshakes
    # cannot stall GT forcewake during concurrent encode + compute.
    "i915.enable_dc=0"
    # Hard-freeze diagnostic (nine silent freezes 2026-07..2026-10-31, see
    # docs/hard-hang-cstate.md): disable PCIe ASPM at every layer. BIOS-side,
    # all ASPM options are set to Disabled by hand. The 2026-10-26 reading
    # "consumer-desktop firmware does not program ASPM" is superseded — the
    # firmware was found with every ASPM option Enabled (2026-10-31) and _OSC
    # does not hand the OS the PCIe power-management control bit, so kernel
    # policy alone could not zero ASPM here. This parameter kills the kernel
    # ASPM subsystem and refuses driver-initiated enables, which covers
    # r8169: it manages RTL8125B ASPM outside the pcie_aspm.policy scope.
    # Acceptance: root lspci -vv must show ASPM Disabled on 08:00.0, 03:00.0
    # and their root ports. Keeping it costs ~2-4 W idle.
    "pcie_aspm=off"
  ];

  # Hardware decode/encode (VA-API iHD), QSV (oneVPL), OpenCL/Level Zero.
  hardware.graphics.extraPackages = with pkgs; [
    intel-media-driver
    vpl-gpu-rt
    intel-compute-runtime
  ];

  # Make VA-API use the modern iHD backend instead of the legacy i965 driver.
  environment.sessionVariables.LIBVA_DRIVER_NAME = "iHD";

  # Resizable BAR comes from the board firmware natively since the B760M
  # swap (BIOS H7.8G; GPU BAR verified at 8G) — no ReBarState needed.
  environment.systemPackages = with pkgs; [ nvtopPackages.intel ];

  # Allow intel_gpu_top to run without root for GPU monitoring.
  hardware.intel-gpu-tools.enable = true;

  # The A380 firmware lives in linux-firmware, already pulled in by
  # hardware.enableRedistributableFirmware in hosts/briefcase/default.nix.
}
